# Copy to ~/.config/jev-opus/.env (or run `jev-opus init`). A repo clone also reads ./.env.

# TypeSafe Jev System-1 reflex — decides the Opus 5.5 effort level per step
JEV_API_KEY=apikey_...
# …or Jev through OpenRouter instead:
# OPENROUTER_API_KEY=sk-or-...
# JEV_PROVIDER=openrouter
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# Evaluator reliability (all optional)
# JEV_DEADLINE_MS=1500          # one overall deadline per Jev decision, covering any retries
# JEV_RETRIES=0                 # extra attempts allowed inside the same deadline
# JEV_BREAKER_THRESHOLD=3       # consecutive failures before the circuit opens
# JEV_BREAKER_COOLDOWN_MS=30000 # cooldown before one recovery probe goes through on real traffic

# Claude credential for the Claude Code child process. Leave empty to use `claude auth login`.
# Plain ANTHROPIC_* / CLAUDE_CODE_* values are honored only when written in this file
# (or ./.env) — the same variables inherited from a parent Claude session are stripped
# and never passed on unless you opt in below.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# JEV_OPUS_ANTHROPIC_API_KEY=       # JEV_OPUS_* names always count as jev-opus config
# JEV_OPUS_CLAUDE_OAUTH_TOKEN=
# JEV_OPUS_ANTHROPIC_AUTH_TOKEN=
# JEV_OPUS_ANTHROPIC_BASE_URL=
# JEV_OPUS_INHERIT_CREDENTIALS=1    # allow an inherited ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN

# JEV_OPUS_MODEL=claude-opus-5-5
# JEV_OPUS_MIN_EFFORT=low
# JEV_OPUS_MAX_EFFORT=high      # ceiling; set xhigh or max to allow them
# JEV_OPUS_CLAUDEAI_CONNECTORS=1  # let the child load your claude.ai connectors
# JEV_OPUS_NO_INLINE_EFFORT=1     # disable live effort badges in Claude Code messages
# JEV_OPUS_NO_STATUSLINE=1        # omit the Jev footer status line
